{
  "manifest_version": 3,
  "name": "cowkoszyku Biedronka",
  "version": "1.0.3",
  "description": "Catches Moja Biedronka app:// OAuth redirects and finishes sign-in on cowkoszyku /imports/biedronka.",
  "permissions": ["webRequest", "webNavigation", "tabs"],
  "host_permissions": [
    "https://konto.biedronka.pl/*",
    "http://localhost:5173/*",
    "http://127.0.0.1:5173/*",
    "http://localhost:3000/*",
    "http://127.0.0.1:3000/*",
    "http://localhost:8080/*",
    "http://127.0.0.1:8080/*",
    "*://cowkoszyku.home.arpa/*",
    "*://cowkoszyku.piekna2.pl/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost:5173/imports/biedronka",
        "http://localhost:5173/imports/biedronka*",
        "http://127.0.0.1:5173/imports/biedronka",
        "http://127.0.0.1:5173/imports/biedronka*",
        "http://localhost:3000/imports/biedronka",
        "http://localhost:3000/imports/biedronka*",
        "http://127.0.0.1:3000/imports/biedronka",
        "http://127.0.0.1:3000/imports/biedronka*",
        "http://localhost:8080/imports/biedronka",
        "http://localhost:8080/imports/biedronka*",
        "http://127.0.0.1:8080/imports/biedronka",
        "http://127.0.0.1:8080/imports/biedronka*",
        "*://cowkoszyku.home.arpa/imports/biedronka",
        "*://cowkoszyku.home.arpa/imports/biedronka*",
        "*://cowkoszyku.piekna2.pl/imports/biedronka",
        "*://cowkoszyku.piekna2.pl/imports/biedronka*"
      ],
      "js": ["content-cowkoszyku.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://konto.biedronka.pl/*"],
      "js": ["content-keycloak.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://konto.biedronka.pl/*"],
      "js": ["inject-keycloak.js"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ]
}
