{
  "manifest_version": 3,
  "name": "cowkoszyku Biedronka",
  "version": "1.2.1",
  "description": "Opens the Biedronka bill list and sends finished bills to cowkoszyku.",
  "permissions": ["webRequest", "webNavigation", "tabs", "storage", "declarativeNetRequest", "declarativeNetRequestWithHostAccess"],
  "host_permissions": [
    "https://konto.biedronka.pl/*",
    "https://api.prod.biedronka.cloud/*",
    "http://localhost:5173/*",
    "http://127.0.0.1:5173/*",
    "http://localhost:3000/*",
    "http://127.0.0.1:3000/*",
    "http://localhost:8080/*",
    "http://127.0.0.1:8080/*",
    "*://cowkoszyku.home.arpa/*",
    "*://cowkoszyku.piekna2.pl/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "biedronka_ua",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost:5173/admin/receipts/imports/biedronka",
        "http://localhost:5173/admin/receipts/imports/biedronka*",
        "http://127.0.0.1:5173/admin/receipts/imports/biedronka",
        "http://127.0.0.1:5173/admin/receipts/imports/biedronka*",
        "http://localhost:3000/admin/receipts/imports/biedronka",
        "http://localhost:3000/admin/receipts/imports/biedronka*",
        "http://127.0.0.1:3000/admin/receipts/imports/biedronka",
        "http://127.0.0.1:3000/admin/receipts/imports/biedronka*",
        "http://localhost:8080/admin/receipts/imports/biedronka",
        "http://localhost:8080/admin/receipts/imports/biedronka*",
        "http://127.0.0.1:8080/admin/receipts/imports/biedronka",
        "http://127.0.0.1:8080/admin/receipts/imports/biedronka*",
        "*://cowkoszyku.home.arpa/admin/receipts/imports/biedronka",
        "*://cowkoszyku.home.arpa/admin/receipts/imports/biedronka*",
        "*://cowkoszyku.piekna2.pl/admin/receipts/imports/biedronka",
        "*://cowkoszyku.piekna2.pl/admin/receipts/imports/biedronka*"
      ],
      "js": ["content-cowkoszyku.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://konto.biedronka.pl/*"],
      "js": ["content-keycloak.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://konto.biedronka.pl/*"],
      "js": ["inject-keycloak.js"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ]
}
